# SAFY 개발 환경변수 템플릿
# 사용법: 이 파일을 .env로 복사한 뒤, 실제 값을 채워 넣으세요.
# ⬜ 표시는 아직 팀 확인이 필요한 항목입니다. BE/AI/DB 담당자 확정 후 채워주세요.

# ==========================================
# OpenVidu (WebRTC 미디어 서버) - 별도 스택으로 실행, 여기서는 연결 정보만
# ==========================================
# OpenVidu Community v3(LiveKit+mediasoup)는 이 docker-compose.yml이 아니라
# 공식 별도 스택(local-deployment / docker-compose-deployment)으로 띄운다.
# 아래 URL/키는 그 스택을 실행한 뒤 거기서 발급된 값으로 채운다.
# ⬜ 로컬 OpenVidu 스택 실행 방식 확정 후 실제 URL/포트로 교체 (구버전 4443 포트 아님)
OPENVIDU_URL=
OPENVIDU_API_KEY=
OPENVIDU_API_SECRET=

# ==========================================
# Spring Boot (Java 21, Spring Boot 4.1.0) - 확정
# ==========================================
SPRING_PORT=8080
# 존재하는 프로필은 dev / prod / test 뿐이다. local 프로필은 없어서
# 지정하면 datasource 설정을 찾지 못해 부팅에 실패한다.
# dev = ddl-auto:update(Hibernate가 스키마 자동 생성), prod = ddl-auto:validate.
# Flyway 도입 전까지는 dev를 쓴다.
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# DB - PostgreSQL, Redis - 확정
# ==========================================
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safy
DB_USER=
DB_PASSWORD=

# 주의: 이 Redis는 Spring Boot 전용. OpenVidu 내부용 Redis와는 별개(그쪽 스택에서 자체 관리).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# ⬜ Redis 용도(세션 캐시/실시간 데이터 등) BE 확정 후 추가

# ==========================================
# Python (AI 서버) - FastAPI 확정
# ==========================================
AI_SERVER_PORT=8000
AI_SERVER_HOST=0.0.0.0

# P2PNet은 기본적으로 비활성화한다. GPU 호스트에서 가중치 URL과 인증을
# 설정하고 체크섬 검증을 확인한 뒤 true로 변경한다.
P2PNET_SHADOW_ENABLED=false
P2PNET_SHADOW_DEVICE=cpu
P2PNET_SHADOW_THRESHOLD=0.5
P2PNET_SHADOW_TIMEOUT_SECONDS=5.0

# 기존 MinIO(아래 MINIO_ENDPOINT/MINIO_PUBLIC_ENDPOINT)의 safy-ai-models
# 버킷에 게시한 epoch-003.pth presigned 다운로드 URL. 예:
# https://i15a503.p.ssafy.io:9200/safy-ai-models/p2pnet/
#   safy-p2pnet-v2-epoch3/epoch-003.pth?<presigned-query-params>
# presigned URL은 만료되므로 인프라가 주기적으로 재발급해 갱신해야 한다.
P2PNET_SHADOW_WEIGHT_URL=

# presigned URL 서명에 인증이 포함되므로 기본값은 비워둔다. presigned URL
# 대신 nginx 헤더 검증 방식을 쓰기로 하면 그때 이름/값을 채운다.
# 아래 값은 절대 Git에 커밋하지 않고 실서버 .env에만 저장한다.
P2PNET_ASSET_AUTH_HEADER_NAME=
P2PNET_ASSET_AUTH_HEADER_VALUE=
P2PNET_ASSET_DOWNLOAD_TIMEOUT_SECONDS=60

# ==========================================
# React (FE) - Vite 기준 확정
# ==========================================
VITE_API_BASE_URL=http://localhost:8080
# ⬜ VITE_OPENVIDU_URL은 OpenVidu 로컬 스택 확정 후 실제 값으로 교체
VITE_OPENVIDU_URL=

# ==========================================
# MinIO — 제보(이미지/영상) 업로드 저장용 - 확정
# ==========================================
# 주의: 이건 시민 제보 업로드 전용 MinIO다. OpenVidu 스택에도 자체 MinIO가 따로 있고
# 그쪽 자격증명은 OpenVidu 스택 쪽 .env에서 관리한다(여기 값과 다름).
# 단 WebRTC 녹화(Egress)는 OpenVidu 것이 아니라 이 MinIO에 저장된다 — backend가
# Egress 요청에 이 버킷과 자격증명을 명시해 넘기기 때문이다(LiveKitMediaGateway).
# 그 주소는 아래 LIVE_RECORDING_S3_ENDPOINT로 따로 지정한다.
MINIO_ENDPOINT=http://localhost:9000
# 브라우저가 presigned URL로 직접 접속하는 주소. 내부 주소(minio:9000)를 쓰면
# 브라우저가 닿지 못해 이미지 업로드가 실패한다. 실서버는 공개 호스트로 지정한다.
# 앱이 https로 서비스되므로 이 값도 https여야 한다. http면 브라우저가
# mixed content로 판단해 업로드 요청을 보내기 전에 차단한다(2026-07-29 실측).
# 실서버는 https://i15a503.p.ssafy.io:9200 — 9200에서 nginx가 TLS를 종단하고
# minio:9000으로 평문 프록시한다(nginx/minio.conf).
# 주의: 여기 적은 host와 포트가 그대로 서명에 포함된다. nginx가 Host를 그대로
# 넘기지 않으면 MinIO가 재계산한 서명과 어긋나 403이 된다.
MINIO_PUBLIC_ENDPOINT=

# nginx가 MinIO용 TLS에 쓸 인증서 디렉터리(호스트 경로).
# 비워두면 실서버 기본값(OpenVidu Caddy가 관리하는 Let's Encrypt 인증서)을 쓴다.
# 로컬에서 compose를 통째로 띄울 때 그 경로가 없으면 nginx가 기동에 실패하므로
# 자체 서명 인증서를 만들어 이 변수로 지정한다. 파일명은 아래 두 개여야 한다:
#   i15a503.p.ssafy.io.crt / i15a503.p.ssafy.io.key
MINIO_TLS_CERT_DIR=
# ACCESS_KEY는 사용자명이라 읽기 쉬운 값을 쓴다(예: safy-app).
# minioadmin 등 알려진 기본값은 쓰지 않는다 — 9200이 외부에 공개돼 있다.
MINIO_ACCESS_KEY=
# SECRET_KEY는 비밀번호다. 명명 규칙 없이 랜덤으로 생성한다: openssl rand -base64 24
MINIO_SECRET_KEY=
MINIO_UPLOAD_BUCKET=safy-reports

# 녹화(Egress)가 업로드할 S3 주소. 위 MINIO_ENDPOINT와 별개다.
# OpenVidu의 egress 컨테이너는 host 네트워크라 브리지 이름 minio를 해석하지 못한다.
# 실서버는 compose가 127.0.0.1:9202에 게시하는 S3 API를 쓴다:
#   LIVE_RECORDING_S3_ENDPOINT=http://127.0.0.1:9202
# 비워두면 http://minio:9000 으로 떨어져 기존 동작과 같아진다(= 녹화 업로드 실패).
LIVE_RECORDING_S3_ENDPOINT=

# ==========================================
# 인증 / OAuth / CORS - backend 부팅과 로그인에 필수
# ==========================================
# JWT_SECRET은 32바이트 이상이어야 한다. 짧으면 부팅에 실패한다.
# 생성: openssl rand -base64 48
JWT_SECRET=
# 액세스 토큰 유효 시간(예: 15m, 1h). 짧을수록 안전하지만 재발급이 잦아진다.
AUTH_ACCESS_TOKEN_TTL=1h
# 리프레시 쿠키(SAFY_REFRESH_TOKEN, 14일)에 Secure 속성을 붙일지.
# true면 브라우저가 이 쿠키를 https 연결에만 실어 보낸다.
# 실서버는 true — 정식 진입점이 https이고, 평문 8091로 리프레시 토큰이
# 나가면 그걸 주운 사람이 14일간 비밀번호 없이 세션을 유지할 수 있다.
# 로컬 개발은 http라서 true로 두면 로그인이 유지되지 않으므로 false.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
# 프론트가 실제로 서비스되는 출처. 실서버는 https://i15a503.p.ssafy.io
# (앱은 /api/v1 상대경로를 쓰므로 실서버에서는 same-origin이라 CORS를 타지 않는다.
#  이 값은 로컬 개발 서버에서 붙을 때 의미가 있다.)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 로그인 성공/실패 후 브라우저를 보낼 프론트 주소.
# 실서버는 https://i15a503.p.ssafy.io/oauth/callback, .../login
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:3000/oauth/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:3000/login

# 소셜로그인 자격증명. 비워두면 docker-compose가 not-configured로 대체해
# 부팅은 되지만 소셜로그인은 동작하지 않는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 카카오 로컬 API 키(좌표 → 행정구역 변환). 위 소셜로그인 키와 다른 값이다.
# 카카오 개발자 콘솔에서 앱 생성 시 즉시 발급되며 별도 심사가 없다.
# 비어 있으면 제보가 관제센터에 배정되지 않고, 홈 화면의 위치 조회도 실패한다.
KAKAO_LOCAL_REST_API_KEY=

# 최초 관리자 계정. 부팅 시 없으면 생성된다. 비우면 어드민 로그인이 불가능하다.
SUPER_ADMIN_LOGIN_ID=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_DISPLAY_NAME=Super Admin
