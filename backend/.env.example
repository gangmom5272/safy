# Spring Boot profile: local, dev, prod
SPRING_PROFILES_ACTIVE=dev
SPRING_PORT=8080

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# OpenVidu
OPENVIDU_URL=
OPENVIDU_API_KEY=
OPENVIDU_API_SECRET=

# MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_UPLOAD_BUCKET=

# AI server
AI_SERVER_PORT=8000

# Authentication (use a random value of at least 32 bytes)
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
# Access Token 유효 시간 (예: 15m, 1h). 운영에서는 짧게 두는 것을 권장합니다.
AUTH_ACCESS_TOKEN_TTL=1h
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:3000/oauth/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:3000/login
CORS_ALLOWED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_LOCAL_REST_API_KEY=

# Report routing
REPORT_ROUTING_MAX_ATTEMPTS=5
REPORT_ROUTING_RETRY_DELAY=PT1M
REPORT_ROUTING_BATCH_SIZE=50
REPORT_ROUTING_SCHEDULER_DELAY=PT30S
REPORT_ASSIGNMENT_SCHEDULER_DELAY=PT30S

# Optional first super administrator
SUPER_ADMIN_LOGIN_ID=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_DISPLAY_NAME=Super Admin
