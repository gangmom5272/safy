# Spring Boot profile: local, dev, prod
SPRING_PROFILES_ACTIVE=dev
SPRING_PORT=8080

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# OpenVidu
OPENVIDU_URL=
OPENVIDU_API_KEY=
OPENVIDU_API_SECRET=

# MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_UPLOAD_BUCKET=

# AI server
AI_SERVER_PORT=8000

# Authentication (use a random value of at least 32 bytes)
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:3000/oauth/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:3000/login
CORS_ALLOWED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Optional first super administrator
SUPER_ADMIN_LOGIN_ID=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_DISPLAY_NAME=Super Admin
